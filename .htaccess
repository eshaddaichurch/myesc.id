SetEnv DC_FOTO_SECRET 7c3e64bf508912da
RewriteEngine On

# Tambahkan ini di paling atas, sebelum rule lainnya
RewriteCond %{REQUEST_URI} ^/myesc\.id/(.*)$
RewriteRule ^myesc\.id/(.*)$ $1 [L]

# Rule CI3 yang sudah ada
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]